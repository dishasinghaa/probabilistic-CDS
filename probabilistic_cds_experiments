        "\n",
        "fig, axes = plt.subplots(1, 3, figsize=(15, 4.5), sharey=True)\n",
        "\n",
        "for ax, p, title in zip(axes, p_snapshots, titles):\n",
        "    r0 = run_many_trajectories_vectorized(0.25, p, c, e, T_snapshot, n_trials, rng)\n",
