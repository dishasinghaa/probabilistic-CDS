        "    ax.grid(True, alpha=0.2)\n",
        "    ax.legend(loc='upper right')\n",
        "\n",
        "axes[0].set_ylabel(\"Trajectory Counts\", fontsize=10)\n",
        "plt.suptitle(f\"Phase Space Trajectory Distributions at Horizon T={T_snapshot}\", fontsize=13, y=1.03)\n",
        "plt.tight_layout()\n",
        "plt.show()"
