        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# Deterministic Trajectory Generator\n",
        "# ============================================================\n",
        "def run_deterministic_trajectory(x0, p, c, e, T):\n",
        "    \"\"\"\n",
        "    Runs a SINGLE deterministic trajectory for a given p.\n",
        "    Uses a low-discrepancy rule to guarantee exactly fraction p of steps are contractions.\n",
        "    \"\"\"\n",
        "    x = x0\n",
        "    for t in range(T):\n",
        "        # Deterministic sequence rule (no random coin flips)\n",
        "        is_contract = ((t * p) % 1.0) < p\n",
        "        factor = c if is_contract else e\n",
        "        x = (factor * x) % 1.0\n",
        "    return x\n",
        "\n",
        "def deterministic_w1_sweep(c, e, T, p_values):\n",
        "    w1_scores = []\n",
        "    for p in p_values:\n",
        "        # Both initial points follow the exact same deterministic sequence\n",
        "        r0 = run_deterministic_trajectory(0.25, p, c, e, T)\n",
        "        r1 = run_deterministic_trajectory(0.75, p, c, e, T)\n",
        "        # Distance between two single points on the line\n",
        "        w1_scores.append(np.abs(r0 - r1))\n",
        "    return np.array(w1_scores)\n",
        "\n",
        "# ============================================================\n",
        "# Parameters & Execution\n",
        "# ============================================================\n",
        "c, e = 0.5, 2.0\n",
        "T = 100\n",
        "p_star = np.log(e) / (np.log(e) - np.log(c))\n",
        "p_values = np.linspace(0.01, 0.99, 500)  # High resolution to capture jagged spikes\n",
        "\n",
        "w1_deterministic = deterministic_w1_sweep(c, e, T, p_values)\n",
        "\n",
        "# Plotting\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(p_values, w1_deterministic, color='crimson', lw=1.2, label=f\"Deterministic ($T={T}$)\")\n",
        "plt.axvline(p_star, color='black', linestyle='--', lw=2, label=f\"Theoretical $p^* = {p_star:.3f}$\")\n",
        "\n",
        "plt.xlabel(\"p (Fraction of Contracting Steps)\", fontsize=11)\n",
