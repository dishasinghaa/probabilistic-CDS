        "plt.title(\"Deterministic Phase Space Separability: Chaos, Spikes, and Collapse\", fontsize=12)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.legend(loc=\"upper right\")\n",
        "plt.tight_layout()\n",
