        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# LAYER 1 & 2: Vectorized IFS Dynamics\n",
        "# ============================================================\n",
        "def run_many_trajectories_vectorized(x0, p, c, e, T, n_trials, rng):\n",
        "    \"\"\"\n",
        "    Simulates n_trials independent trajectories for T steps in parallel.\n",
        "    Applies contraction (prob p) or expansion (prob 1-p) mod 1.\n",
        "    \"\"\"\n",
        "    x = np.full(n_trials, x0)\n",
        "    coin_flips = rng.random((T, n_trials)) < p\n",
        "    for t in range(T):\n",
        "        contract_mask = coin_flips[t]\n",
        "        x = np.where(contract_mask, (c * x) % 1.0, (e * x) % 1.0)\n",
        "    return x\n",
        "\n",
        "# ============================================================\n",
        "# LAYER 3: 1D Wasserstein-1 Distance Metric\n",
        "# ============================================================\n",
        "def wasserstein_1d(samples0, samples1):\n",
        "    \"\"\"\n",
        "    Calculates the exact 1D Wasserstein-1 distance (Earth Mover's Distance)\n",
        "    between two empirical distributions via sorting.\n",
        "    \"\"\"\n",
        "    sorted0 = np.sort(samples0)\n",
        "    sorted1 = np.sort(samples1)\n",
        "    return np.mean(np.abs(sorted0 - sorted1))\n",
        "\n",
        "# ============================================================\n",
        "# LAYER 4: Theoretical Critical Point (Edge of Chaos)\n",
        "# ============================================================\n",
        "def theoretical_p_star(c, e):\n",
        "    \"\"\"Calculates the exact closed-form p* where Lyapunov exponent \\lambda_L = 0.\"\"\"\n",
        "    return np.log(e) / (np.log(e) - np.log(c))\n",
        "\n",
        "# ============================================================\n",
        "# LAYER 5: Parameter Sweep over p with Multi-Seed Averaging\n",
        "# ============================================================\n",
        "def sweep_p_wasserstein(c, e, T, n_trials, p_values, n_seeds=5, base_seed=42):\n",
        "    \"\"\"Averages W1 over multiple random seeds per p to isolate true dynamics from noise.\"\"\"\n",
        "    all_w1 = np.zeros((n_seeds, len(p_values)))\n",
        "    for s in range(n_seeds):\n",
        "        rng = np.random.default_rng(base_seed + s)\n",
        "        for j, p in enumerate(p_values):\n",
        "            r0 = run_many_trajectories_vectorized(0.25, p, c, e, T, n_trials, rng)\n",
        "            r1 = run_many_trajectories_vectorized(0.75, p, c, e, T, n_trials, rng)\n",
        "            all_w1[s, j] = wasserstein_1d(r0, r1)\n",
        "    return all_w1.mean(axis=0), all_w1.std(axis=0)\n",
        "\n",
        "# ============================================================\n",
        "# EXECUTION: EXPERIMENT 1 — Phase Transition Curve Across Horizons T\n",
        "# ============================================================\n",
        "c, e = 0.5, 2.0\n",
        "n_trials = 3000\n",
        "p_star = theoretical_p_star(c, e)\n",
        "print(f\"Theoretical edge-of-chaos p* = {p_star:.4f}\")\n",
        "\n",
        "p_values = np.linspace(0.01, 0.99, 60)\n",
        "T_values = [20, 100, 500]\n",
        "\n",
        "plt.figure(figsize=(9, 5.5))\n",
        "for T in T_values:\n",
        "    w1_mean, w1_std = sweep_p_wasserstein(c, e, T, n_trials=n_trials, p_values=p_values, n_seeds=5)\n",
        "    plt.plot(p_values, w1_mean, label=f\"T={T}\", lw=2)\n",
        "    plt.fill_between(p_values, w1_mean - w1_std, w1_mean + w1_std, alpha=0.15)\n",
        "\n",
        "plt.axvline(p_star, color='red', linestyle='--', lw=2, label=f\"Theoretical p* = {p_star:.3f}\")\n",
        "plt.xlabel(\"p (Probability of Contraction)\", fontsize=11)\n",
        "plt.ylabel(\"Wasserstein-1 Distance $W_1(P_0, P_1)$\", fontsize=11)\n",
        "plt.title(\"Probabilistic CDS: Memory Retention Phase Transition Across Horizons T\", fontsize=12)\n",
        "plt.legend(frameon=True, facecolor='white', framealpha=0.9)\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# EXECUTION: EXPERIMENT 2 — Phase Space Distributions (Layer 6)\n",
        "# ============================================================\n",
        "rng = np.random.default_rng(123)\n",
        "T_snapshot = 100\n",
        "p_snapshots = [0.2, p_star, 0.8]\n",
        "titles = [\n",
        "    f\"p=0.200 (Chaotic / Folding)\\n$\\lambda_L > 0$\",\n",
