        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# Reuse from before: run_many_trajectories_vectorized, wasserstein_1d,\n",
        "# theoretical_p_star\n",
        "# ============================================================\n",
        "\n",
        "def decay_rate_at_p(p, c, e, T_list, n_trials, n_seeds, base_seed=42):\n",
        "    \"\"\"\n",
        "    For a fixed p, computes W1 at each T in T_list (averaged over seeds),\n",
        "    then fits log(W1) = -gamma*T + intercept via least squares.\n",
        "    Returns gamma (the decay rate) and the raw (T, W1) points for inspection.\n",
        "    \"\"\"\n",
        "    w1_means = []\n",
        "    for T in T_list:\n",
        "        w1_vals = []\n",
        "        for s in range(n_seeds):\n",
        "            rng = np.random.default_rng(base_seed + s)\n",
        "            r0 = run_many_trajectories_vectorized(0.25, p, c, e, T, n_trials, rng)\n",
        "            r1 = run_many_trajectories_vectorized(0.75, p, c, e, T, n_trials, rng)\n",
        "            w1_vals.append(wasserstein_1d(r0, r1))\n",
        "        w1_means.append(np.mean(w1_vals))\n",
        "\n",
        "    w1_means = np.array(w1_means)\n",
        "    T_arr = np.array(T_list)\n",
        "\n",
        "    # Only fit where W1 is meaningfully above numerical noise floor\n",
        "    valid = w1_means > 1e-8\n",
        "    if valid.sum() < 2:\n",
        "        return np.nan, T_arr, w1_means  # not enough signal to fit a rate\n",
        "\n",
        "    log_w1 = np.log(w1_means[valid])\n",
        "    T_valid = T_arr[valid]\n",
        "\n",
        "    # Linear fit: log(W1) = -gamma * T + b  =>  slope = -gamma\n",
        "    slope, intercept = np.polyfit(T_valid, log_w1, 1)\n",
        "    gamma = -slope\n",
        "\n",
        "    return gamma, T_arr, w1_means\n",
        "\n",
        "\n",
        "def sweep_gamma_across_p(c, e, p_values, T_list, n_trials, n_seeds):\n",
        "    gammas = []\n",
        "    for p in p_values:\n",
        "        gamma, _, _ = decay_rate_at_p(p, c, e, T_list, n_trials, n_seeds)\n",
        "        gammas.append(gamma)\n",
        "        print(f\"p={p:.3f}  gamma={gamma:.5f}\")\n",
        "    return np.array(gammas)\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# RUN\n",
        "# ============================================================\n",
        "c, e = 0.5, 2.0\n",
        "p_star = theoretical_p_star(c, e)\n",
        "print(f\"Theoretical p* = {p_star:.4f}\\n\")\n",
        "\n",
        "p_values = np.linspace(0.05, 0.95, 25)   # coarser grid — this is more compute-intensive\n",
        "T_list = [10, 20, 40, 80, 160, 320]       # multiple horizons to fit the decay slope\n",
        "n_trials = 2000\n",
        "n_seeds = 3\n",
        "\n",
        "gammas = sweep_gamma_across_p(c, e, p_values, T_list, n_trials, n_seeds)\n",
        "\n",
        "plt.figure(figsize=(9, 5.5))\n",
        "plt.plot(p_values, gammas, marker='o', color='purple')\n",
        "plt.axvline(p_star, color='red', linestyle='--', lw=2, label=f\"Theoretical p* = {p_star:.3f}\")\n",
        "plt.xlabel(\"p (Probability of Contraction)\")\n",
        "plt.ylabel(\"Decay rate γ(p)  [higher = memory dies faster]\")\n",
