        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ============================================================\n",
        "# CORE DYNAMICS\n",
        "# ============================================================\n",
        "def run_many_trajectories_vectorized(x0, p, c, e, T, n_trials, rng):\n",
        "    x = np.full(n_trials, x0)\n",
        "    coin_flips = rng.random((T, n_trials)) < p\n",
        "    for t in range(T):\n",
        "        contract_mask = coin_flips[t]\n",
        "        x = np.where(contract_mask, (c * x) % 1.0, (e * x) % 1.0)\n",
        "    return x\n",
        "\n",
        "def wasserstein_1d(samples0, samples1):\n",
        "    sorted0 = np.sort(samples0)\n",
        "    sorted1 = np.sort(samples1)\n",
        "    return np.mean(np.abs(sorted0 - sorted1))\n",
        "\n",
        "def theoretical_p_star(c, e):\n",
        "    return np.log(e) / (np.log(e) - np.log(c))\n",
        "\n",
        "def decay_rate_at_p(p, c, e, T_list, n_trials, n_seeds, base_seed=42):\n",
        "    w1_means = []\n",
        "    for T in T_list:\n",
        "        w1_vals = []\n",
        "        for s in range(n_seeds):\n",
        "            rng = np.random.default_rng(base_seed + s)\n",
        "            r0 = run_many_trajectories_vectorized(0.25, p, c, e, T, n_trials, rng)\n",
        "            r1 = run_many_trajectories_vectorized(0.75, p, c, e, T, n_trials, rng)\n",
        "            w1_vals.append(wasserstein_1d(r0, r1))\n",
        "        w1_means.append(np.mean(w1_vals))\n",
        "\n",
        "    w1_means = np.array(w1_means)\n",
        "    T_arr = np.array(T_list)\n",
        "    valid = w1_means > 1e-8\n",
        "    if valid.sum() < 2:\n",
        "        return np.nan, T_arr, w1_means\n",
        "\n",
        "    log_w1 = np.log(w1_means[valid])\n",
        "    T_valid = T_arr[valid]\n",
        "    slope, intercept = np.polyfit(T_valid, log_w1, 1)\n",
        "    gamma = -slope\n",
        "    return gamma, T_arr, w1_means\n",
        "\n",
        "def sweep_gamma_across_p(c, e, p_values, T_list, n_trials, n_seeds):\n",
        "    gammas = []\n",
        "    for p in p_values:\n",
        "        gamma, _, _ = decay_rate_at_p(p, c, e, T_list, n_trials, n_seeds)\n",
        "        gammas.append(gamma)\n",
        "        print(f\"  p={p:.3f}  gamma={gamma:.5f}\")\n",
        "    return np.array(gammas)\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT A: Universality check across (c, e) pairs\n",
        "# ============================================================\n",
        "def run_full_experiment(c, e, T_list, n_trials, n_seeds, p_range_width=0.35, n_p=21):\n",
        "    p_star = theoretical_p_star(c, e)\n",
        "    p_values = np.linspace(\n",
        "        max(0.02, p_star - p_range_width),\n",
        "        min(0.98, p_star + p_range_width),\n",
        "        n_p\n",
        "    )\n",
        "    print(f\"\\n--- c={c}, e={e}, theoretical p*={p_star:.4f} ---\")\n",
        "    gammas = sweep_gamma_across_p(c, e, p_values, T_list, n_trials, n_seeds)\n",
        "    return p_star, p_values, gammas\n",
        "\n",
        "\n",
        "configs = [\n",
        "    (0.5, 2.0),\n",
        "    (0.3, 3.0),\n",
        "    (0.7, 1.5),\n",
        "]\n",
        "\n",
        "T_list = [10, 20, 40, 80, 160, 320]\n",
        "n_trials = 2000\n",
        "n_seeds = 3\n",
        "\n",
        "all_results = {}\n",
        "for c, e in configs:\n",
        "    p_star, p_values, gammas = run_full_experiment(c, e, T_list, n_trials, n_seeds)\n",
        "    all_results[(c, e)] = (p_star, p_values, gammas)\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "colors = ['purple', 'darkgreen', 'darkorange']\n",
        "for (c, e), color in zip(configs, colors):\n",
        "    p_star, p_values, gammas = all_results[(c, e)]\n",
        "    plt.plot(p_values - p_star, gammas, marker='o', color=color,\n",
        "             label=f\"c={c}, e={e} (p*={p_star:.3f})\")\n",
        "\n",
        "plt.axvline(0, color='red', linestyle='--', lw=2, label=\"p - p* = 0 (critical point)\")\n",
        "plt.xlabel(\"p - p*  (distance from theoretical critical point)\")\n",
        "plt.ylabel(\"Decay rate γ(p)\")\n",
        "plt.title(\"Universality Check: γ(p) minimum aligns with p* across different (c, e)\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"universality_check.png\", dpi=150, bbox_inches='tight')\n",
        "plt.show()\n",
        "\n",
        "# ============================================================\n",
        "# EXPERIMENT B: Fit critical exponent for the (0.5, 2.0) case\n",
        "# ============================================================\n",
        "def fit_v_shape(p_values, gammas, p_star, window=0.15):\n",
        "    delta = p_values - p_star\n",
        "    mask = (np.abs(delta) > 1e-6) & (np.abs(delta) < window) & (gammas > 1e-6) & ~np.isnan(gammas)\n",
        "    log_delta = np.log(np.abs(delta[mask]))\n",
        "    log_gamma = np.log(gammas[mask])\n",
        "\n",
        "    if mask.sum() < 3:\n",
        "        return np.nan, np.nan\n",
        "\n",
        "    alpha, logA = np.polyfit(log_delta, log_gamma, 1)\n",
        "    return alpha, np.exp(logA)\n",
        "\n",
        "c0, e0 = 0.5, 2.0\n",
        "p_star0, p_values0, gammas0 = all_results[(c0, e0)]\n",
        "\n",
        "alpha, A = fit_v_shape(p_values0, gammas0, p_star0)\n",
        "print(f\"\\n=== Critical exponent fit (c={c0}, e={e0}) ===\")\n",
        "print(f\"gamma(p) ~ {A:.4f} * |p - p*|^{alpha:.3f}  near criticality\")\n",
        "\n",
        "plt.figure(figsize=(8, 5.5))\n",
        "delta = p_values0 - p_star0\n",
        "mask = (np.abs(delta) > 1e-6) & (np.abs(delta) < 0.15) & (gammas0 > 1e-6) & ~np.isnan(gammas0)\n",
        "plt.scatter(np.log(np.abs(delta[mask])), np.log(gammas0[mask]), color='purple', label=\"Data\")\n",
        "fit_x = np.linspace(np.log(np.abs(delta[mask])).min(), np.log(np.abs(delta[mask])).max(), 50)\n",
        "plt.plot(fit_x, alpha * fit_x + np.log(A), color='red', linestyle='--',\n",
        "          label=f\"Fit: slope (α) = {alpha:.3f}\")\n",
        "plt.xlabel(\"log|p - p*|\")\n",
        "plt.ylabel(\"log γ(p)\")\n",
        "plt.title(\"Critical Exponent Fit near p*\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.tight_layout()\n",
